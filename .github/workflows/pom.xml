<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.cococraft</groupId>
    <artifactId>CococraftTweaks</artifactId>
    <version>1.2.0</version>
    <packaging>jar</packaging>

    <properties>
        <!-- Si al compilar sale un error de "class file version" por el paper-api,
             sube esto a 25 (el setup-java del workflow ya usa JDK 25). -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>dmulloy2</id>
            <url>https://repo.dmulloy2.net/repository/public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/releases/</url>
        </repository>
        <repository>
            <id>codemc</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API. Misma version que tu servidor. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>26.1.2-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- ProtocolLib: tweak de cofres/barriles y AxTrade countdown.
             Compilas contra 5.3.0; en el servidor corre el dev build de 26.1. -->
        <dependency>
            <groupId>com.comphenix.protocol</groupId>
            <artifactId>ProtocolLib</artifactId>
            <version>5.3.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- PacketEvents: handler de la tecla L (ADVANCEMENT_TAB).
             AJUSTA la version a la que corras. Este scope 'provided' asume que
             usas PacketEvents como PLUGIN aparte (depend en plugin.yml). Si en
             tu setup lo shadeas/relocalizas dentro del jar, avisame: cambia el
             scope y hay que anadir el shade-plugin con relocation. -->
        <dependency>
            <groupId>com.github.retrooper</groupId>
            <artifactId>packetevents-spigot</artifactId>
            <version>2.7.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- PlaceholderAPI: expansion %cococraft_axtrade_countdown%. -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!-- DeluxeMenus: apertura del menu por API (Menu.getMenuByName / openMenu).
             La instala el workflow desde Hangar con install-file, con estas mismas
             coordenadas. Scope provided: ya esta en tu servidor, no se empaqueta. -->
        <dependency>
            <groupId>com.extendedclip.deluxemenus</groupId>
            <artifactId>DeluxeMenus</artifactId>
            <version>1.14.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- El jar sale siempre como CococraftTweaks.jar, sin el numero de version. -->
        <finalName>CococraftTweaks</finalName>
    </build>
</project>
